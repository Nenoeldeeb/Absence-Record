# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = false
trim_trailing_whitespace = true
max_line_length = 128
ij_formatter_enabled = true
ij_formatter_tags_enabled = true

# Kotlin files
[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_name_count_to_use_star_import = 99
ij_kotlin_name_count_to_use_star_import_for_members = 99
ij_kotlin_packages_to_use_import_on_demand = false
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
ij_kotlin_align_multiline_parameters = true
ij_kotlin_align_multiline_method_parentheses = false
ij_kotlin_align_multiline_binary_operation = true
ij_kotlin_space_after_comma = true
ij_kotlin_space_before_comma = false

ktlint_standard_filename = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-consecutive-blank-lines = enabled
ktlint_standard_no-semi = enabled
ktlint_standard_colon-spacing = enabled
ktlint_standard_comma-spacing = enabled
ktlint_standard_no-blank-line-before-rbrace = enabled
ktlint_standard_chain-wrapping = enabled
ktlint_standard_parameter-list-wrapping = enabled
ktlint_standard_comment-spacing = enabled
ktlint_standard_string-template = enabled
ktlint_standard_string-template-indent = enabled

# Java files
[*.java]
ij_java_names_count_to_use_import_on_demand = 99
ij_java_class_count_to_use_import_on_demand = 99
ij_java_imports_layout = *, |, javax.**, java.**, |, $*
ij_java_layout_static_imports_separately = true
ij_java_blank_lines_around_method = 1
ij_java_blank_lines_around_class = 1

# XML files
[*.xml]
ij_xml_align_attributes = true
ij_xml_align_text = true
ij_xml_attribute_wrap = normal
ij_xml_block_comment_add_space = true

# Resource files
[*.{properties,strings,metals}]
indent_size = 2
ij_properties_spaces_around_key_value_delimiter = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off
indent_size = 2

# JSON files
[*.json]
indent_size = 2
ij_json_keep_line_breaks = true
ij_json_space_after_colon = true
ij_json_space_before_colon = false
ij_json_spaces_within_braces = false
ij_json_spaces_within_brackets = false

# YAML files
[*.{yml,yaml}]
indent_size = 2
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 2

# Git config files
[{.gitignore,.gitmodules,.gitattributes}]
indent_style = tab

# ProGuard files
[proguard-*.pro]
indent_size = 2